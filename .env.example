# Project-local credentials. Copy this file to .env and fill it in.
# .env is excluded by .gitignore, so the token stays in this directory and is
# never committed and never written to your user profile.

# Hugging Face token, used only to download the CLIP encoders.
# Create one at https://huggingface.co/settings/tokens with read access.
# Anonymous downloads are rate limited far more aggressively than
# authenticated ones, which is why this exists.
HF_TOKEN=
