# Agent and tooling artifacts
temp/
CLAUDE.md
AGENTS.md
.agents
.claude
skills-lock.json
claude-**.bat
claude-rules.md

# Project-scoped toolchain and caches (never installed globally)
.python/
.venv/
.uv-cache/
.models/
# External programs Setup.bat installs here when the machine lacks them
.tools/

# Pipeline working data
cache/
output/

# Drop movies into input/. The folder itself is tracked so it exists after a
# clone, but its contents never are.
input/*
!input/README.md

# Environment. This project keeps no .env, everything is set in code, but
# the pattern stays so a stray one can never be committed.
.env
.env.*

# Dependencies
node_modules/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Build output
dist/
build/
*.log

# OS
Thumbs.db
Desktop.ini
.DS_Store
